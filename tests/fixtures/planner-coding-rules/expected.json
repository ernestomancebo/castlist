{
  "description": "A planner carrying a test command and style rules, which belong to the implementer.",
  "covers": [
    "skills/prune/**",
    "commands/prune.md",
    "agents/**"
  ],
  "steps": [
    {
      "prompt": "/castlist:prune",
      "answers": [
        {
          "when": {},
          "select": "Apply"
        }
      ],
      "expect": {
        "files_changed": [
          ".claude/agents/planner.md"
        ],
        "file_assertions": [
          {
            "path": ".claude/agents/planner.md",
            "not_contains": "npm test"
          },
          {
            "path": ".claude/agents/planner.md",
            "not_contains": "code style guide"
          },
          {
            "path": ".claude/agents/planner.md",
            "contains": "PLAN.md"
          }
        ],
        "proposals": [
          {
            "role": "planner",
            "kinds": [
              "prune",
              "rehome"
            ]
          }
        ]
      }
    }
  ]
}
