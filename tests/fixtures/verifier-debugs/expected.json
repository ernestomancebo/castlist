{
  "description": "A verifier told to root-cause and fix bugs, with no debugger role to own that.",
  "covers": [
    "skills/prune/**",
    "commands/prune.md",
    "agents/**"
  ],
  "steps": [
    {
      "prompt": "/castlist:prune",
      "answers": [
        {
          "when": {
            "option": "pattern-following"
          },
          "select": "Judgment"
        },
        {
          "when": {
            "option": "module"
          },
          "select": "Module"
        },
        {
          "when": {
            "option": "high"
          },
          "select": "Low"
        },
        {
          "when": {},
          "select": "Apply"
        }
      ],
      "expect": {
        "files_created": [
          ".claude/agents/debugger.md"
        ],
        "files_changed": [
          ".claude/agents/verifier.md"
        ],
        "files_unchanged": [
          ".claude/agents/implementer.md"
        ],
        "file_assertions": [
          {
            "path": ".claude/agents/verifier.md",
            "not_contains": "fix it"
          },
          {
            "path": ".claude/agents/debugger.md",
            "contains": "name: debugger"
          }
        ],
        "proposals": [
          {
            "role": "verifier",
            "kinds": [
              "prune"
            ]
          },
          {
            "role": "debugger",
            "kinds": [
              "new-agent"
            ]
          }
        ]
      }
    }
  ]
}
