{
  "description": "A lookup role told to recommend fixes and write plans.",
  "covers": [
    "skills/prune/**",
    "commands/prune.md",
    "agents/**"
  ],
  "steps": [
    {
      "prompt": "/castlist:prune",
      "answers": [
        {
          "when": {},
          "select": "Apply"
        }
      ],
      "expect": {
        "files_changed": [
          ".claude/agents/researcher.md"
        ],
        "file_assertions": [
          {
            "path": ".claude/agents/researcher.md",
            "not_contains": "recommended fix"
          }
        ],
        "proposals": [
          {
            "role": "researcher",
            "kinds": [
              "prune"
            ]
          }
        ]
      }
    }
  ]
}
