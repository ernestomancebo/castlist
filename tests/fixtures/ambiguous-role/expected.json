{
  "description": "A vaguely described role that cannot be classified; asked once, then remembered.",
  "covers": [
    "skills/prune/**",
    "commands/prune.md",
    "agents/**"
  ],
  "steps": [
    {
      "prompt": "/castlist:prune",
      "answers": [
        {
          "when": {
            "question": "which archetype"
          },
          "select": "lookup"
        },
        {
          "when": {
            "option": "pattern-following"
          },
          "select": "Judgment"
        },
        {
          "when": {
            "option": "module"
          },
          "select": "Module"
        },
        {
          "when": {
            "option": "high"
          },
          "select": "Low"
        },
        {
          "when": {},
          "select": "Apply"
        }
      ],
      "expect": {
        "files_created": [
          ".claude/castlist.json"
        ],
        "file_assertions": [
          {
            "path": ".claude/castlist.json",
            "json_has": {
              "roles": {
                "triager": "lookup"
              }
            }
          }
        ],
        "proposals": [
          {
            "role": "triager",
            "kinds": [
              "classification-question"
            ]
          }
        ]
      }
    },
    {
      "prompt": "/castlist:prune",
      "answers": [],
      "expect": {
        "questions": 0,
        "files_unchanged": [
          ".claude/castlist.json"
        ]
      }
    }
  ]
}
