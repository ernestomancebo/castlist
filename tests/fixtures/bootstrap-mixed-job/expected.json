{
  "description": "Bootstrap where the person describes one role that plans and implements.",
  "covers": [
    "skills/setup/**",
    "skills/prune/**",
    "skills/catch-up/**",
    "commands/setup.md",
    "agents/**"
  ],
  "steps": [
    {
      "prompt": "/castlist:setup",
      "answers": [
        {
          "when": {
            "option": "split"
          },
          "select": "Split"
        },
        {
          "when": {
            "question": "starting roles"
          },
          "select": [
            "verifier",
            "researcher",
            "builder: plans and implements features"
          ]
        },
        {
          "when": {
            "question": "costly"
          },
          "select": "Medium"
        },
        {
          "when": {
            "question": "judgment"
          },
          "select": "Judgment"
        },
        {
          "when": {
            "question": "context"
          },
          "select": "Module"
        },
        {
          "when": {},
          "select": "Apply"
        }
      ],
      "expect": {
        "questions_include": [
          "builder"
        ],
        "files_created": [
          ".claude/agents/planner.md",
          ".claude/agents/implementer.md",
          ".claude/agents/verifier.md",
          ".claude/agents/researcher.md"
        ],
        "files_absent": [
          ".claude/agents/builder.md"
        ],
        "proposals": [
          {
            "role": "builder",
            "kinds": [
              "split-offer"
            ]
          }
        ]
      }
    }
  ]
}
