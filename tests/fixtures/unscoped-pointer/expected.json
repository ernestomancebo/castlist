{
  "description": "A planner pointed at the whole conventions file instead of only architecture and structure.",
  "covers": [
    "skills/prune/**",
    "commands/prune.md",
    "agents/**"
  ],
  "steps": [
    {
      "prompt": "/castlist:prune",
      "answers": [
        {
          "when": {
            "option": "pattern-following"
          },
          "select": "Judgment"
        },
        {
          "when": {
            "option": "module"
          },
          "select": "Module"
        },
        {
          "when": {
            "option": "high"
          },
          "select": "Low"
        },
        {
          "when": {},
          "select": "Apply"
        }
      ],
      "expect": {
        "files_changed": [
          ".claude/agents/planner.md"
        ],
        "file_assertions": [
          {
            "path": ".claude/agents/planner.md",
            "contains": "architecture and structure conventions only"
          },
          {
            "path": ".claude/agents/planner.md",
            "not_contains": "conventions before starting"
          }
        ],
        "proposals": [
          {
            "role": "planner",
            "kinds": [
              "scoped-pointer"
            ]
          }
        ]
      }
    }
  ]
}
